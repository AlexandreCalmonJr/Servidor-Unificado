        </div>
    </div>
</div>

<!-- ===== PROVISION MODAL ===== -->
<div class="modal-overlay" id="provision-modal">
    <div class="modal-box">
        <div class="modal-header">
            <h3>Gerar Token de Provisionamento</h3>
            <button class="modal-close" id="provision-modal-close">×</button>
        </div>
        <div class="modal-body">
            <!-- FORM SECTION -->
            <div id="provision-form-content">
                <div class="form-group">
                    <label for="form-provision-org">Organização</label>
                    <input type="text" id="form-provision-org" required placeholder="Ex: Empresa ABC">
                </div>
                <div class="form-group">
                    <label for="form-provision-profile">Perfil de Configuração</label>
                    <select id="form-provision-profile" required class="filter-select" style="width: 100%;">
                        <option value="" disabled selected>Selecione um perfil...</option>
                    </select>
                </div>
                <div style="display:flex;gap:16px;">
                    <div class="form-group" style="flex:1;">
                        <label for="form-provision-uses">Usos Máximos</label>
                        <input type="number" id="form-provision-uses" value="1" min="1" max="100">
                    </div>
                    <div class="form-group" style="flex:1;">
                        <label for="form-provision-hours">Expiração (horas)</label>
                        <input type="number" id="form-provision-hours" value="24" min="1" max="720">
                    </div>
                </div>
                <div class="modal-footer"
                    style="padding: 20px 0 0 0; margin-top: 20px; border-top: 1px solid var(--border-color);">
                    <button class="btn btn-ghost" id="provision-modal-cancel">Cancelar</button>
                    <button class="btn btn-primary" id="provision-modal-save">🔑 Gerar Token</button>
                </div>
            </div>

            <!-- RESULT SECTION (Hidden by default) -->
            <div id="provision-result-content" class="hidden text-center">
                <div
                    style="display:flex; justify-content:center; margin-bottom: 20px; background: white; padding: 15px; border-radius: 10px; width: fit-content; margin-left: auto; margin-right: auto;">
                    <div id="modal-qrcode"></div>
                </div>

                <div class="form-group">
                    <label
                        style="display:block; text-align:left; font-size: 0.8rem; text-transform:uppercase; color:var(--text-muted); margin-bottom: 5px;">URL
                        de Provisionamento</label>
                    <div style="display:flex; gap:8px;">
                        <input type="text" id="modal-token-url" readonly
                            style="flex:1; background:var(--bg-secondary); border:1px solid var(--border-color); color:var(--text-primary); padding:8px; border-radius:4px;">
                        <button id="btn-copy-url" class="btn btn-secondary" style="padding: 0 12px;">📋</button>
                    </div>
                </div>

                <div style="margin-top:15px; text-align:center;">
                    <p style="font-size:0.9rem; color:var(--text-muted);">Token: <strong id="modal-token-code"
                            style="color:var(--text-primary); font-family:monospace; font-size:1.1rem;">--</strong></p>
                </div>

                <div class="modal-footer"
                    style="padding: 20px 0 0 0; margin-top: 20px; border-top: 1px solid var(--border-color);">
                    <button class="btn btn-primary" id="btn-close-result" style="width:100%;">Fechar</button>
                </div>
            </div>
        </div>
        <!-- Footer removed from here as it is moved inside the sections -->
    </div>
</div>

<!-- ===== PROFILE MODAL ===== -->
<div class="modal-overlay" id="profile-modal">
    <div class="modal-box" style="max-width: 600px;">
        <div class="modal-header">
            <h3 id="profile-modal-title">Novo Perfil</h3>
            <button class="modal-close" id="profile-modal-close">×</button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label for="form-profile-name">Nome do Perfil</label>
                <input type="text" id="form-profile-name" required placeholder="Ex: Quiosque Padrão">
            </div>
            <div class="form-group">
                <label for="form-profile-desc">Descrição</label>
                <input type="text" id="form-profile-desc" placeholder="Descrição opcional">
            </div>
            <div style="margin-bottom:16px;">
                <label style="font-weight:600;margin-bottom:8px;display:block;">Restrições</label>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                    <label style="display:flex;align-items:center;gap:8px;cursor:pointer;"><input type="checkbox"
                            id="form-profile-camera"> Desativar Câmera</label>
                    <label style="display:flex;align-items:center;gap:8px;cursor:pointer;"><input type="checkbox"
                            id="form-profile-bluetooth"> Desativar Bluetooth</label>
                    <label style="display:flex;align-items:center;gap:8px;cursor:pointer;"><input type="checkbox"
                            id="form-profile-usb"> Desativar USB</label>
                    <label style="display:flex;align-items:center;gap:8px;cursor:pointer;"><input type="checkbox"
                            id="form-profile-dev" checked> Desativar Dev Options</label>
                </div>
            </div>
            <div class="form-group">
                <label for="form-profile-wifi">WiFi Configs</label>
                <textarea id="form-profile-wifi" rows="3" placeholder="SSID|senha|WPA2 (um por linha)"></textarea>
            </div>
            <div class="form-group">
                <label for="form-profile-whitelist">App Whitelist</label>
                <textarea id="form-profile-whitelist" rows="2" placeholder="com.app.name (um por linha)"></textarea>
            </div>
            <div class="form-group">
                <label for="form-profile-blacklist">App Blacklist</label>
                <textarea id="form-profile-blacklist" rows="2" placeholder="com.app.name (um por linha)"></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-ghost" id="profile-modal-cancel">Cancelar</button>
            <button class="btn btn-primary" id="profile-modal-save">Salvar</button>
        </div>
    </div>
</div>

<!-- ===== COMMAND MODAL ===== -->
<div class="modal-overlay" id="command-modal">
    <div class="modal-box">
        <div class="modal-header">
            <h3>Enviar Comando</h3>
            <button class="modal-close" id="command-modal-close">×</button>
        </div>
        <div class="modal-body">
            <div style="padding: 8px 0 16px; color: var(--text-muted); font-size: 0.85rem;">
                Alvo: <strong id="cmd-target-label" style="color: var(--accent);">--</strong>
            </div>
            <div class="form-group">
                <label for="form-cmd-type">Tipo de Comando</label>
                <select id="form-cmd-type" required class="filter-select" style="width: 100%;">
                    <option value="" disabled selected>Selecione...</option>
                </select>
            </div>
            <div class="form-group" id="cmd-custom-group">
                <label for="form-cmd-command">Comando</label>
                <input type="text" id="form-cmd-command" placeholder="Ex: ipconfig /flushdns"
                    style="width:100%;padding:10px 14px;background:var(--bg-input);border:1px solid var(--border-color);border-radius:var(--radius-md);color:var(--text-primary);font-family:var(--font-mono);font-size:0.85rem;">
            </div>
            <div style="display:flex;gap:16px;align-items:center;">
                <div class="form-group" style="flex:1;">
                    <label for="form-cmd-timeout">Timeout (ms)</label>
                    <input type="number" id="form-cmd-timeout" value="60000" min="5000" max="300000"
                        style="width:100%;padding:10px 14px;background:var(--bg-input);border:1px solid var(--border-color);border-radius:var(--radius-md);color:var(--text-primary);font-family:var(--font-mono);font-size:0.85rem;">
                </div>
                <div class="form-group">
                    <label style="display:flex;align-items:center;gap:8px;cursor:pointer;margin-top:20px;">
                        <input type="checkbox" id="form-cmd-elevation">
                        <span>Elevação (Admin)</span>
                    </label>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-ghost" id="command-modal-cancel">Cancelar</button>
            <button class="btn btn-primary" id="command-modal-save">⚡ Enviar</button>
        </div>
    </div>
</div>

<!-- ===== RESULT MODAL ===== -->
<div class="modal-overlay" id="result-modal">
    <div class="modal-box" style="max-width: 700px;">
        <div class="modal-header">
            <h3>Resultado do Comando</h3>
            <button class="modal-close" id="result-modal-close">×</button>
        </div>
        <div class="modal-body" id="result-content">
        </div>
        <div class="modal-footer">
            <button class="btn btn-ghost" id="result-modal-close-btn">Fechar</button>
        </div>
    </div>
</div>

<!-- ===== CHANGE PASSWORD MODAL ===== -->
<div class="modal-overlay" id="password-modal">
    <div class="modal-box" style="max-width: 420px;">
        <div class="modal-header">
            <h3>🔒 Alterar Senha</h3>
            <button class="modal-close" id="password-modal-close">×</button>
        </div>
        <div class="modal-body">
            <form id="password-form">
                <div class="form-group">
                    <label for="form-current-password">Senha Atual</label>
                    <input type="password" id="form-current-password" required placeholder="Sua senha atual">
                </div>
                <div class="form-group">
                    <label for="form-new-password">Nova Senha</label>
                    <input type="password" id="form-new-password" required placeholder="Mínimo 6 caracteres"
                        minlength="6">
                </div>
                <div class="form-group">
                    <label for="form-confirm-password">Confirmar Nova Senha</label>
                    <input type="password" id="form-confirm-password" required placeholder="Repita a nova senha">
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn btn-ghost" id="password-modal-cancel">Cancelar</button>
            <button class="btn btn-primary" id="password-modal-save">🔑 Alterar Senha</button>
        </div>
    </div>
</div>

<!-- Confirm Action Modal -->
<div class="modal" id="confirm-modal">
    <div class="modal-content" style="max-width:420px;">
        <div class="modal-header">
            <h2>⚠️ Confirmação</h2>
            <button class="modal-close" id="confirm-modal-close">&times;</button>
        </div>
        <div class="modal-body" style="padding:20px;">
            <p id="confirm-modal-message" style="font-size:14px;line-height:1.6;color:var(--text-secondary);"></p>
        </div>
        <div class="modal-footer">
            <button class="btn btn-ghost" id="confirm-modal-cancel">Cancelar</button>
            <button class="btn btn-danger" id="confirm-modal-ok">Confirmar</button>
        </div>
    </div>
</div>