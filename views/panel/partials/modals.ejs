<!-- ===== DYNAMIC ASSET MODAL ===== -->
<div class="modal-overlay" id="dynamic-asset-modal">
    <div class="modal-box">
        <div class="modal-header">
            <h3 id="dynamic-asset-modal-title">Novo Ativo</h3>
            <button class="modal-close" id="dynamic-asset-modal-close">×</button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="dynamic-asset-id">
            <div class="form-group">
                <label for="dynamic-asset-name">Nome do Ativo</label>
                <input type="text" id="dynamic-asset-name" required placeholder="ex: Desktop-RH-01">
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label for="dynamic-asset-identifier">Serial / Identificador</label>
                    <input type="text" id="dynamic-asset-identifier" placeholder="SN12345">
                </div>
                <div class="form-group">
                    <label for="dynamic-asset-ip">Endereço IP</label>
                    <input type="text" id="dynamic-asset-ip" placeholder="10.0.0.50">
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label for="dynamic-asset-location">Localização</label>
                    <input type="text" id="dynamic-asset-location" placeholder="Sala 301">
                </div>
                <div class="form-group">
                    <label for="dynamic-asset-status">Status</label>
                    <select id="dynamic-asset-status">
                        <option value="active">Ativo</option>
                        <option value="inactive">Inativo</option>
                        <option value="maintenance">Manutenção</option>
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label for="dynamic-asset-notes">Observações</label>
                <textarea id="dynamic-asset-notes" rows="3" placeholder="Informações adicionais..."></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-ghost" id="dynamic-asset-modal-cancel">Cancelar</button>
            <button class="btn btn-primary" id="dynamic-asset-modal-save">💾 Salvar</button>
        </div>
    </div>
</div>

<!-- ===== USER MODAL ===== -->
<div class="modal-overlay" id="user-modal">
    <div class="modal-box">
        <div class="modal-header">
            <h3 id="user-modal-title">Novo Usuário</h3>
            <button class="modal-close" id="user-modal-close">×</button>
        </div>
        <div class="modal-body">
            <form id="user-form">
                <input type="hidden" id="edit-user-id">
                <div class="form-group">
                    <label for="form-username">Usuário</label>
                    <input type="text" id="form-username" required placeholder="ex: joao.silva">
                </div>
                <div class="form-group">
                    <label for="form-email">Email</label>
                    <input type="email" id="form-email" required placeholder="joao@empresa.com">
                </div>
                <div class="form-group">
                    <label for="form-password">Senha</label>
                    <input type="password" id="form-password" placeholder="Mínimo 6 caracteres">
                </div>
                <div class="form-group">
                    <label for="form-role">Permissão</label>
                    <select id="form-role" required>
                        <option value="user">Usuário</option>
                        <option value="admin">Administrador</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="form-sector">Setor</label>
                    <input type="text" id="form-sector" placeholder="Ex: Engenharia, Produção">
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn btn-ghost" id="user-modal-cancel">Cancelar</button>
            <button class="btn btn-primary" id="user-modal-save">Salvar</button>
        </div>
    </div>
</div>

<!-- ===== DEVICE DETAIL MODAL ===== -->
<div class="modal-overlay" id="device-modal">
    <div class="modal-box" style="max-width: 640px;">
        <div class="modal-header">
            <h3 id="device-modal-title">Detalhes do Dispositivo</h3>
            <button class="modal-close" id="device-modal-close">×</button>
        </div>
        <div class="modal-body">
            <div class="detail-grid" id="device-detail-grid">
                <!-- Filled by JS -->
            </div>

            <div class="history-section"
                style="margin-top: 24px; border-top: 1px solid var(--border-color); padding-top: 16px;">
                <h4 style="margin-bottom: 12px; font-size: 0.95rem; color: var(--text-primary);">Histórico de
                    Localização</h4>
                <div class="table-container" style="max-height: 200px; overflow-y: auto;">
                    <table class="data-table" style="font-size: 0.85rem;">
                        <thead>
                            <tr>
                                <th>Data</th>
                                <th>BSSID</th>
                                <th>Setor</th>
                                <th>Andar</th>
                            </tr>
                        </thead>
                        <tbody id="device-history-body">
                            <tr>
                                <td colspan="4" class="text-center text-muted">Carregando...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-ghost" id="device-modal-close-btn">Fechar</button>
            <button class="btn btn-primary" id="device-modal-edit-btn">Editar</button>
        </div>
    </div>
</div>

<!-- ===== DEVICE EDIT MODAL ===== -->
<div class="modal-overlay" id="device-edit-modal">
    <div class="modal-box">
        <div class="modal-header">
            <h3>Editar Dispositivo</h3>
            <button class="modal-close" id="device-edit-modal-close">×</button>
        </div>
        <div class="modal-body">
            <form id="device-edit-form">
                <input type="hidden" id="edit-device-serial">

                <div class="form-row">
                    <div class="form-group">
                        <label>Nome</label>
                        <input type="text" id="form-device-name" required>
                    </div>
                    <div class="form-group">
                        <label>Serial</label>
                        <input type="text" id="form-device-serial" readonly
                            style="background:var(--bg-secondary);cursor:not-allowed;">
                    </div>
                </div>

                <div class="form-group">
                    <label>Unidade</label>
                    <input type="text" id="form-device-unit">
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Setor</label>
                        <input type="text" id="form-device-sector">
                    </div>
                    <div class="form-group">
                        <label>Andar</label>
                        <input type="text" id="form-device-floor">
                    </div>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn btn-ghost" id="device-edit-modal-cancel">Cancelar</button>
            <button class="btn btn-primary" id="device-edit-modal-save">Salvar</button>
        </div>
    </div>
</div>

<!-- ===== MODULE MODAL ===== -->
<div class="modal-overlay" id="module-modal">
    <div class="modal-box">
        <div class="modal-header">
            <h3 id="module-modal-title">Novo Módulo</h3>
            <button class="modal-close" id="module-modal-close">×</button>
        </div>
        <div class="modal-body">
            <div class="modal-tabs">
                <button class="modal-tab active" onclick="openTab(event, 'tab-general')">Geral</button>
                <button class="modal-tab" onclick="openTab(event, 'tab-client')">Cliente UI</button>
                <button class="modal-tab" onclick="openTab(event, 'tab-features')">Funcionalidades</button>
            </div>

            <form id="module-form">
                <input type="hidden" id="edit-module-id">

                <!-- TAB GERAL -->
                <div id="tab-general" class="tab-content active">
                    <div class="form-group">
                        <label for="form-module-name">Nome do Módulo</label>
                        <input type="text" id="form-module-name" required placeholder="Ex: Notebooks TI">
                    </div>
                    <div class="form-group">
                        <label for="form-module-type">Tipo Base</label>
                        <select id="form-module-type" required>
                            <option value="" disabled selected>Selecione o tipo...</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="form-module-desc">Descrição</label>
                        <textarea id="form-module-desc" rows="3" placeholder="Descrição opcional..."></textarea>
                    </div>
                    <div class="form-group">
                        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                            <input type="checkbox" id="form-module-active" checked>
                            <span>Módulo Ativo</span>
                        </label>
                    </div>
                </div>

                <!-- TAB CLIENTE -->
                <div id="tab-client" class="tab-content" style="display:none;">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Ícone (Material Icon)</label>
                            <input type="text" id="form-module-icon" placeholder="ex: ad_units" value="box">
                        </div>
                        <div class="form-group" style="max-width: 100px;">
                            <label>Cor</label>
                            <input type="color" id="form-module-color" value="#3b82f6"
                                style="width:100%;height:38px;padding:0;border:none;">
                        </div>
                    </div>
                    <div class="form-group">
                        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                            <input type="checkbox" id="form-module-show-dash" checked>
                            <span>Mostrar no Dashboard</span>
                        </label>
                    </div>
                    <div class="form-group">
                        <label>Abas Visíveis (separadas por vírgula)</label>
                        <input type="text" id="form-module-tabs" placeholder="info, location, apps">
                    </div>
                </div>

                <!-- TAB FEATURES -->
                <div id="tab-features" class="tab-content" style="display:none;">
                    <div class="form-group">
                        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                            <input type="checkbox" id="flag-remote-control">
                            <span>Permitir Controle Remoto</span>
                        </label>
                    </div>
                    <div class="form-group">
                        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                            <input type="checkbox" id="flag-track-location" checked>
                            <span>Rastreamento de Localização</span>
                        </label>
                    </div>
                    <div class="form-group">
                        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                            <input type="checkbox" id="flag-require-auth" checked>
                            <span>Exigir Autenticação no Agente</span>
                        </label>
                    </div>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn btn-ghost" id="module-modal-cancel">Cancelar</button>
            <button class="btn btn-primary" id="module-modal-save">Salvar</button>
        </div>
    </div>
</div>

<!-- ===== TOTEM MODAL ===== -->
<div class="modal-overlay" id="totem-modal">
    <div class="modal-box">
        <div class="modal-header">
            <h3 id="totem-modal-title">Editar Totem</h3>
            <button class="modal-close" id="totem-modal-close">×</button>
        </div>
        <div class="modal-body">
            <form id="totem-form">
                <input type="hidden" id="edit-totem-serial">

                <div class="form-row">
                    <div class="form-group">
                        <label>Hostname</label>
                        <input type="text" id="form-totem-hostname" required>
                    </div>
                    <div class="form-group">
                        <label>Serial</label>
                        <input type="text" id="form-totem-serial" readonly
                            style="background:var(--bg-secondary);cursor:not-allowed;">
                    </div>
                </div>

                <div class="form-group">
                    <label>IP</label>
                    <input type="text" id="form-totem-ip" readonly
                        style="background:var(--bg-secondary);cursor:not-allowed;">
                </div>

                <div class="form-group">
                    <label>Notas / Observações</label>
                    <textarea id="form-totem-notes" rows="3" placeholder="Anotações administrativas..."></textarea>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn btn-ghost" id="totem-modal-cancel">Cancelar</button>
            <button class="btn btn-primary" id="totem-modal-save">Salvar</button>
        </div>
    </div>
</div>

<!-- ===== UNIT MODAL ===== -->
<div class="modal-overlay" id="unit-modal">
    <div class="modal-box">
        <div class="modal-header">
            <h3 id="unit-modal-title">Nova Unidade</h3>
            <button class="modal-close" id="unit-modal-close">×</button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="edit-unit-name">
            <div class="form-group">
                <label for="form-unit-name">Nome da Unidade</label>
                <input type="text" id="form-unit-name" required placeholder="Ex: Filial São Paulo">
            </div>
            <div class="form-group">
                <label>Faixas de IP</label>
                <div id="ip-ranges-container">
                    <div class="ip-range-row">
                        <input type="text" class="range-start" placeholder="IP Inicial (ex: 192.168.1.1)">
                        <span style="color: var(--text-muted);">—</span>
                        <input type="text" class="range-end" placeholder="IP Final (ex: 192.168.1.254)">
                    </div>
                </div>
                <button type="button" class="btn btn-ghost btn-sm" id="add-ip-range-btn" style="margin-top: 8px;">+
                    Adicionar Faixa</button>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-ghost" id="unit-modal-cancel">Cancelar</button>
            <button class="btn btn-primary" id="unit-modal-save">Salvar</button>
        </div>
    </div>
</div>

<!-- ===== BSSID MODAL ===== -->
