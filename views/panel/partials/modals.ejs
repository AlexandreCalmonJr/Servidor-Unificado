        </div>
    </div>
</div>

<!-- ===== IP MODAL ===== -->
<div class="modal-overlay" id="ip-modal">
    <div class="modal-box">
        <div class="modal-header">
            <h3>Novo Mapeamento IP</h3>
            <button class="modal-close" id="ip-modal-close">×</button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label for="form-ip-location">Localização</label>
