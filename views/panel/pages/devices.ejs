<!-- ===== DEVICES ===== -->
<div class="page-section" id="page-devices">
    <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-white">Dispositivos</h2>
    </div>

    <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden shadow-lg">
        <div class="p-4 border-b border-slate-800 flex flex-col md:flex-row gap-4 justify-between items-center">
            <h3 class="font-bold text-white hidden md:block">Lista de Dispositivos</h3>

            <div class="flex flex-col md:flex-row gap-3 w-full md:w-auto">
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i data-lucide="search" size="16" class="text-slate-500"></i>
                    </div>
                    <input type="text" id="device-search"
                        class="bg-slate-950 border border-slate-700 text-slate-200 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block w-full pl-10 p-2 placeholder-slate-500 transition-all"
                        placeholder="Buscar dispositivo...">
                </div>

                <select id="device-filter"
                    class="bg-slate-950 border border-slate-700 text-slate-200 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 p-2 transition-all">
                    <option value="all">Todos os Status</option>
                    <option value="active">ativo</option>
                    <option value="completed">provisionado</option>
                    <option value="pending">pendente</option>
                    <option value="maintenance">manutenção</option>
                    <option value="failed">falha</option>
                </select>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-400">
                <thead class="bg-slate-950/50 text-xs uppercase font-semibold text-slate-500">
                    <tr>
                        <th class="p-4">Nome</th>
                        <th class="p-4">Serial</th>
                        <th class="p-4">Modelo</th>
                        <th class="p-4">Bateria</th>
                        <th class="p-4">IP</th>
                        <th class="p-4">Setor</th>
                        <th class="p-4">Status</th>
                        <th class="p-4 text-right">Ações</th>
                    </tr>
                </thead>
                <tbody id="devices-table-body" class="divide-y divide-slate-800">
                    <tr>
                        <td colspan="8" class="p-8 text-center text-slate-500">
                            Carregando...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="p-4 border-t border-slate-800 flex justify-end" id="devices-pagination">
            <!-- Pagination controls injected by JS -->
        </div>
    </div>
</div>