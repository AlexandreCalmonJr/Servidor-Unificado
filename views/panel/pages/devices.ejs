<!-- ===== DEVICES ===== -->
<div class="page-section" id="page-devices">
    <div class="section-header">
        <h2>Dispositivos</h2>
    </div>

    <div class="table-container">
        <div class="table-header">
            <h3>Lista de Dispositivos</h3>
            <div class="table-actions">
                <input type="text" class="search-input" id="device-search" placeholder="Buscar dispositivo...">
                <select class="filter-select" id="device-filter">
                    <option value="all">Todos</option>
                    <option value="active">Ativo</option>
                    <option value="completed">Provisionado</option>
                    <option value="pending">Pendente</option>
                    <option value="maintenance">Manutenção</option>
                    <option value="failed">Falha</option>
                </select>
            </div>
        </div>
        <div style="overflow-x: auto;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Serial</th>
                        <th>Modelo</th>
                        <th>Bateria</th>
                        <th>IP</th>
                        <th>Setor</th>
                        <th>Status</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody id="devices-table-body">
                    <tr>
                        <td colspan="8" class="empty-state">
                            <p>Carregando...</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>