<!-- ===== DIAGNOSTICS ===== -->
<div class="page-section" id="page-diagnostics">
    <div class="section-header">
        <h2>Diagnósticos</h2>
    </div>

    <div class="diag-grid">
        <!-- Location Test -->
        <div class="diag-card">
            <h4>🧪 Teste de Localização</h4>
            <div class="form-group">
                <label for="diag-serial">Serial</label>
                <input type="text" id="diag-serial" placeholder="Número serial...">
            </div>
            <div style="display:flex;gap:8px;">
                <div class="form-group" style="flex:1;">
                    <label for="diag-ip">IP</label>
                    <input type="text" id="diag-ip" placeholder="10.0.0.1">
                </div>
                <div class="form-group" style="flex:1;">
                    <label for="diag-bssid">BSSID</label>
                    <input type="text" id="diag-bssid" placeholder="AA:BB:CC:DD:EE:FF">
                </div>
            </div>
            <button class="btn btn-primary" id="diag-run-btn" style="width:100%;">▶ Executar
                Diagnóstico</button>
            <div class="diag-result" id="diag-location-result">
                <span style="color:var(--text-muted);">Preencha os dados acima e clique em
                    executar.</span>
            </div>
        </div>

        <!-- Cache Stats -->
        <div class="diag-card">
            <h4>⚡ Cache de Localização</h4>
            <div id="diag-cache">
                <span style="color:var(--text-muted);">Carregando...</span>
            </div>
        </div>
    </div>

    <!-- BSSID Validation -->
    <div class="table-container" style="margin-top: 16px;">
        <div class="table-header">
            <h3>📡 Validação de BSSIDs</h3>
        </div>
        <div id="diag-bssid-validation" style="padding: 16px;">
            <div class="empty-state">
                <p>Carregando...</p>
            </div>
        </div>
    </div>

    <!-- Unmapped Devices -->
    <div class="table-container" style="margin-top: 16px;">
        <div class="table-header">
            <h3>❓ Dispositivos Não Mapeados</h3>
        </div>
        <div style="overflow-x: auto;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Serial</th>
                        <th>IP</th>
                        <th>Setor</th>
                        <th>Andar</th>
                        <th>Recomendações</th>
                    </tr>
                </thead>
                <tbody id="diag-unmapped-body">
                    <tr>
                        <td colspan="6" class="empty-state">
                            <p>Carregando...</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Suggestions -->
    <div class="table-container" style="margin-top: 16px;">
        <div class="table-header">
            <h3>💡 Sugestões de Cadastro</h3>
        </div>
        <div id="diag-suggestions" style="padding: 16px;">
            <div class="empty-state">
                <p>Carregando...</p>
            </div>
        </div>
    </div>
</div>