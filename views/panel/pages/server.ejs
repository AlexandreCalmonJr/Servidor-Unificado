<!-- ===== SERVER & APKs ===== -->
<div class="page-section" id="page-server">
    <div class="section-header">
        <h2>Servidor &amp; APKs</h2>
    </div>

    <!-- Server Info Cards -->
    <div class="metrics-grid" style="margin-bottom: 24px;" id="server-metrics-grid">
        <div class="metric-card">
            <div class="metric-header">
                <span class="metric-label">CPU</span>
                <span class="metric-icon">⚡</span>
            </div>
            <div class="metric-value" id="srv-cpu">--%</div>
            <div class="progress-bar-container">
                <div class="progress-bar-bg">
                    <div class="progress-bar-fill" id="srv-cpu-bar" style="width: 0%"></div>
                </div>
            </div>
        </div>
        <div class="metric-card">
            <div class="metric-header">
                <span class="metric-label">Memória</span>
                <span class="metric-icon">🧠</span>
            </div>
            <div class="metric-value" id="srv-memory">--%</div>
            <div class="progress-bar-container">
                <div class="progress-bar-bg">
                    <div class="progress-bar-fill" id="srv-memory-bar" style="width: 0%"></div>
                </div>
            </div>
        </div>
        <div class="metric-card blue">
            <div class="metric-header">
                <span class="metric-label">Uptime</span>
                <span class="metric-icon">⏱</span>
            </div>
            <div class="metric-value" id="srv-uptime">--</div>
            <div class="metric-sub" id="srv-uptime-sub">servidor</div>
        </div>
    </div>

    <!-- APK Management -->
    <div class="table-container">
        <div class="table-header">
            <h3>APKs Disponíveis</h3>
            <div class="table-actions">
                <button class="btn btn-primary btn-sm" id="upload-apk-btn">⬆ Upload APK</button>
            </div>
        </div>
        <div id="apk-list">
            <div class="empty-state">
                <div class="empty-icon">📦</div>
                <p>Carregando APKs...</p>
            </div>
        </div>
    </div>

    <!-- Upload Zone -->
    <div class="modal-overlay" id="upload-modal">
        <div class="modal-box">
            <div class="modal-header">
                <h3>Upload de APK</h3>
                <button class="modal-close" id="upload-modal-close">×</button>
            </div>
            <div class="modal-body">
                <div class="upload-zone" id="upload-zone">
                    <div class="upload-icon">📤</div>
                    <p>Arraste o arquivo .apk aqui ou clique para selecionar</p>
                    <p class="upload-hint">Apenas arquivos .apk — Máximo 200MB</p>
                    <input type="file" id="apk-file-input" accept=".apk" style="display: none;">
                </div>
            </div>
        </div>
    </div>
</div>