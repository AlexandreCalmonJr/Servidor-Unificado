<!-- ===== MAPPINGS ===== -->
<div class="page-section" id="page-mappings">
    <div class="section-header">
        <h2>Mapeamentos</h2>
    </div>

    <div class="tab-bar">
        <button class="tab-btn active" data-tab="units">🏢 Unidades</button>
        <button class="tab-btn" data-tab="bssid">📡 BSSID</button>
        <button class="tab-btn" data-tab="ip">🌐 IP</button>
    </div>

    <!-- Units Tab -->
    <div class="tab-panel active" id="tab-units">
        <div class="table-container">
            <div class="table-header">
                <h3>Unidades</h3>
                <button class="btn btn-primary btn-sm" id="add-unit-btn">+ Nova Unidade</button>
            </div>
            <div style="overflow-x: auto;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Faixas de IP</th>
                            <th>Criado em</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody id="units-table-body">
                        <tr>
                            <td colspan="4" class="empty-state">
                                <p>Carregando...</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- BSSID Tab -->
    <div class="tab-panel" id="tab-bssid">
        <div class="table-container">
            <div class="table-header">
                <h3>Mapeamento BSSID</h3>
                <button class="btn btn-primary btn-sm" id="add-bssid-btn">+ Novo BSSID</button>
            </div>
            <div style="overflow-x: auto;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>MAC Address</th>
                            <th>Setor</th>
                            <th>Andar</th>
                            <th>Unidade</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody id="bssid-table-body">
                        <tr>
                            <td colspan="5" class="empty-state">
                                <p>Carregando...</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- IP Tab -->
    <div class="tab-panel" id="tab-ip">
        <div class="table-container">
            <div class="table-header">
                <h3>Mapeamento de IP</h3>
                <button class="btn btn-primary btn-sm" id="add-ip-btn">+ Novo IP</button>
            </div>
            <div style="overflow-x: auto;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Localização</th>
                            <th>IP Inicial</th>
                            <th>IP Final</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody id="ip-table-body">
                        <tr>
                            <td colspan="4" class="empty-state">
                                <p>Carregando...</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>