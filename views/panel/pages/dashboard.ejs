<!-- ===== DASHBOARD ===== -->
<div class="page-section active" id="page-dashboard">
    <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-white">Visão Geral</h2>
        <button
            class="flex items-center gap-2 bg-slate-800 hover:bg-slate-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors"
            id="refresh-metrics-btn">
            <i data-lucide="refresh-cw" size="16"></i> Atualizar
        </button>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6" id="metrics-grid">

        <!-- Devices Widget -->
        <div
            class="bg-slate-900 border border-slate-800 p-5 rounded-xl hover:border-blue-500/50 transition-colors group">
            <div class="flex justify-between items-start mb-4">
                <div>
                    <p class="text-slate-400 text-sm font-medium mb-1">Dispositivos</p>
                    <h3 class="text-2xl font-bold text-white" id="m-devices">--</h3>
                </div>
                <div class="p-3 rounded-lg bg-slate-800 text-blue-400 group-hover:scale-110 transition-transform">
                    <i data-lucide="smartphone" size="20"></i>
                </div>
            </div>
            <p class="text-xs text-slate-500" id="m-devices-sub">Online</p>
        </div>

        <!-- CPU Widget -->
        <div
            class="bg-slate-900 border border-slate-800 p-5 rounded-xl hover:border-indigo-500/50 transition-colors group">
            <div class="flex justify-between items-start mb-4">
                <div>
                    <p class="text-slate-400 text-sm font-medium mb-1">CPU Servidor</p>
                    <h3 class="text-2xl font-bold text-white" id="m-cpu">--%</h3>
                </div>
                <div class="p-3 rounded-lg bg-slate-800 text-indigo-400 group-hover:scale-110 transition-transform">
                    <i data-lucide="cpu" size="20"></i>
                </div>
            </div>
            <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden mb-2">
                <div class="h-full bg-indigo-500" id="m-cpu-bar" style="width: 0%"></div>
            </div>
            <p class="text-xs text-slate-500">Uso atual</p>
        </div>

        <!-- Memory Widget -->
        <div
            class="bg-slate-900 border border-slate-800 p-5 rounded-xl hover:border-purple-500/50 transition-colors group">
            <div class="flex justify-between items-start mb-4">
                <div>
                    <p class="text-slate-400 text-sm font-medium mb-1">RAM Servidor</p>
                    <h3 class="text-2xl font-bold text-white" id="m-memory">--%</h3>
                </div>
                <div class="p-3 rounded-lg bg-slate-800 text-purple-400 group-hover:scale-110 transition-transform">
                    <i data-lucide="activity" size="20"></i>
                </div>
            </div>
            <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden mb-2">
                <div class="h-full bg-purple-500" id="m-memory-bar" style="width: 0%"></div>
            </div>
            <p class="text-xs text-slate-500">Uso atual</p>
        </div>

        <!-- Uptime Widget -->
        <div
            class="bg-slate-900 border border-slate-800 p-5 rounded-xl hover:border-emerald-500/50 transition-colors group">
            <div class="flex justify-between items-start mb-4">
                <div>
                    <p class="text-slate-400 text-sm font-medium mb-1">Uptime</p>
                    <h3 class="text-2xl font-bold text-white" id="m-uptime">--</h3>
                </div>
                <div class="p-3 rounded-lg bg-slate-800 text-emerald-400 group-hover:scale-110 transition-transform">
                    <i data-lucide="clock" size="20"></i>
                </div>
            </div>
            <p class="text-xs text-slate-500" id="m-uptime-sub">Desde reinício</p>
        </div>
    </div>

    <!-- Recent Devices Table -->
    <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden mb-6">
        <div class="p-4 border-b border-slate-800">
            <h3 class="font-bold text-white">Dispositivos Recentes</h3>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-400">
                <thead class="bg-slate-950">
                    <tr>
                        <th class="p-4 font-medium text-slate-300">Nome</th>
                        <th class="p-4 font-medium text-slate-300">Serial</th>
                        <th class="p-4 font-medium text-slate-300">Última Conexão</th>
                        <th class="p-4 font-medium text-slate-300">Setor</th>
                        <th class="p-4 font-medium text-slate-300">Status</th>
                    </tr>
                </thead>
                <tbody id="recent-devices-body" class="divide-y divide-slate-800">
                    <tr>
                        <td colspan="5" class="p-4 text-center">Carregando...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-4">
            <h3 class="font-bold text-white mb-4">Distribuição de Status</h3>
            <div style="position:relative;height:240px;"><canvas id="chart-status"></canvas></div>
        </div>
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-4">
            <h3 class="font-bold text-white mb-4">Recursos do Servidor</h3>
            <div style="position:relative;height:240px;"><canvas id="chart-resources"></canvas></div>
        </div>
    </div>
</div>