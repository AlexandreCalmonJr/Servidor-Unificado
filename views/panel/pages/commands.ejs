<!-- ===== COMMANDS ===== -->
<div class="page-section" id="page-commands">
    <div class="section-header">
        <h2>Comandos Remotos</h2>
    </div>

    <!-- Step 1: Select Module -->
    <div class="table-container" style="margin-bottom: 16px;">
        <div class="table-header">
            <h3>1. Selecionar Módulo</h3>
        </div>
        <div style="padding: 16px;">
            <select class="filter-select" id="cmd-module-select" style="width: 100%; max-width: 400px;">
                <option value="" disabled selected>Selecione um módulo...</option>
            </select>
        </div>
    </div>

    <!-- Step 2: Select Asset -->
    <div class="table-container" style="margin-bottom: 16px;">
        <div class="table-header">
            <h3>2. Selecionar Ativo</h3>
        </div>
        <div id="cmd-asset-list" style="padding: 16px;">
            <div class="empty-state">
                <div class="empty-icon">⬆️</div>
                <p>Selecione um módulo acima.</p>
            </div>
        </div>
    </div>

    <!-- Step 3: Send Command -->
    <div id="cmd-send-area" style="display: none; margin-bottom: 16px;">
        <div class="table-container">
            <div class="table-header">
                <h3>3. Enviar Comando</h3>
                <button class="btn btn-primary" id="cmd-send-btn">⚡ Enviar Comando</button>
            </div>
        </div>
    </div>

    <!-- Command History -->
    <div id="cmd-history-area" style="display: none;">
        <div class="table-container">
            <div class="table-header">
                <h3>Histórico de Comandos</h3>
            </div>
            <div style="overflow-x: auto;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Tipo</th>
                            <th>Comando</th>
                            <th>Status</th>
                            <th>Enviado</th>
                            <th>Concluído</th>
                            <th>Resultado</th>
                        </tr>
                    </thead>
                    <tbody id="cmd-history-body">
                        <tr>
                            <td colspan="6" class="empty-state">
                                <p>Selecione um ativo.</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>