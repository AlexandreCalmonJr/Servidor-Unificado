MONGO_URI=mongodb://localhost:27017/mdm
JWT_SECRET=replace_with_64_random_bytes_hex
JWT_EXPIRES_IN=2h
AUTH_TOKEN=replace_with_48_random_bytes_hex
TEST_TOKEN=replace_with_32_random_bytes_hex
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info
REDIS_ENABLED=false
REDIS_URL=redis://redis:6379
PRINTER_DEBUG_IMAGING=false

# Optional: sign remote commands returned to desktop agents.
# Store the private key on the server only (never in git). Put the matching public key on agents.
# COMMAND_SIGNING_PRIVATE_KEY_FILE=secrets/command_private_key.pem
# COMMAND_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
