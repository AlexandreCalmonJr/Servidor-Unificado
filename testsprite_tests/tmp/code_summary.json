                                                },
                                                "sector": {
                                                    "type": "string"
                                                },
                                                "floor": {
                                                    "type": "string"
                                                },
                                                "unitId": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                }
                            },
                            "responses": {
                                "201": {
                                    "description": "BSSID mapping created successfully"
                                }
                            }
                        }
                    }
                }
            }
        },
        {
