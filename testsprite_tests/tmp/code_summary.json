        {
            "name": "Health Check & Metrics API",
            "description": "Health checks for Kubernetes and Prometheus metrics",
            "files": [
                "server.js",
                "middleware/metricsMiddleware.js"
            ],
            "api_doc": {
                "openapi": "3.0.0",
                "paths": {
                    "/health": {
                        "get": {
                            "summary": "Health check endpoint",
                            "responses": {
                                "200": {
                                    "description": "Server is healthy",
                                    "content": {
                                        "application/json": {
                                            "schema": {
                                                "type": "object",
                                                "properties": {
                                                    "status": {
                                                        "type": "string"
                                                    },
                                                    "uptime": {
                                                        "type": "integer"
                                                    },
                                                    "services": {
                                                        "type": "object",
                                                        "properties": {
                                                            "mongodb": {
                                                                "type": "object"
                                                            },
                                                            "redis": {
                                                                "type": "object"
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                },
                                "503": {
