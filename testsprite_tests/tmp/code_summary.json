{
    "tech_stack": [
        "Node.js 18",
        "Express 4.18",
        "MongoDB 8.0",
        "Redis 5.9 (optional)",
        "JWT Authentication",
        "Winston Logger",
        "Mongoose ODM",
        "Docker"
    ],
    "features": [
        {
            "name": "Authentication API",
            "description": "User authentication with JWT tokens, login, register, and token verification",
            "files": [
                "routes/authRoutes.js",
                "controllers/authController.js",
                "middleware/auth.js",
                "models/User.js"
            ],
            "api_doc": {
                "openapi": "3.0.0",
                "paths": {
                    "/api/auth/login": {
                        "post": {
                            "summary": "User login",
                            "requestBody": {
                                "required": true,
                                "content": {
                                    "application/json": {
                                        "schema": {
                                            "type": "object",
                                            "properties": {
                                                "username": {
                                                    "type": "string"
                                                },
                                                "password": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "username",
                                                "password"
                                            ]
                                        }
                                    }
                                }
                            },
                            "responses": {
                                "200": {
                                    "description": "Login successful",
                                    "content": {
                                        "application/json": {
                                            "schema": {
                                                "type": "object",
                                                "properties": {
                                                    "success": {
                                                        "type": "boolean"
                                                    },
                                                    "token": {
                                                        "type": "string"
                                                    },
                                                    "user": {
                                                        "type": "object"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "/api/auth/register": {
                        "post": {
                            "summary": "Register new user (admin only)",
                            "security": [
                                {
                                    "bearerAuth": []
                                }
                            ],
                            "requestBody": {
                                "required": true,
                                "content": {
                                    "application/json": {
                                        "schema": {
                                            "type": "object",
                                            "properties": {
                                                "username": {
                                                    "type": "string"
                                                },
                                                "email": {
                                                    "type": "string"
                                                },
                                                "password": {
                                                    "type": "string"
                                                },
                                                "role": {
                                                    "type": "string",
                                                    "enum": [
                                                        "user",
                                                        "admin"
                                                    ]
                                                },
                                                "sector": {
                                                    "type": "string"
                                                },
                                                "permissions": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    }
                                                }
                                            },
                                            "required": [
                                                "username",
                                                "email",
                                                "password"
                                            ]
                                        }
                                    }
                                }
                            },
                            "responses": {
                                "201": {
                                    "description": "User created successfully"
                                }
                            }
                        }
                    },
                    "/api/auth/verify": {
                        "get": {
                            "summary": "Verify JWT token",
                            "security": [
                                {
                                    "bearerAuth": []
                                }
                            ],
                            "responses": {
                                "200": {
                                    "description": "Token is valid"
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "name": "Device Management API",
            "description": "CRUD operations for managing devices (mobile, totem, notebook, desktop, printer, panel)",
            "files": [
                "routes/deviceRoutes.js",
                "models/Device.js",
                "models/Desktop.js",
                "models/Notebook.js",
                "models/Printer.js",
                "models/Panel.js"
            ],
            "api_doc": {
                "openapi": "3.0.0",
                "paths": {
                    "/api/devices": {
                        "get": {
                            "summary": "List all devices with filters",
                            "security": [
                                {
                                    "bearerAuth": []
                                }
                            ],
                            "parameters": [
                                {
                                    "name": "status",
                                    "in": "query",
                                    "schema": {
                                        "type": "string",
                                        "enum": [
                                            "online",
                                            "offline",
                                            "maintenance"
                                        ]
                                    }
                                },
                                {
                                    "name": "device_type",
                                    "in": "query",
                                    "schema": {
                                        "type": "string"
                                    }
                                },
                                {
                                    "name": "unit",
                                    "in": "query",
                                    "schema": {
                                        "type": "string"
                                    }
                                },
                                {
                                    "name": "page",
                                    "in": "query",
                                    "schema": {
                                        "type": "integer"
                                    }
                                },
                                {
                                    "name": "limit",
                                    "in": "query",
                                    "schema": {
                                        "type": "integer"
                                    }
                                }
                            ],
                            "responses": {
                                "200": {
                                    "description": "List of devices",
                                    "content": {
                                        "application/json": {
                                            "schema": {
                                                "type": "object",
                                                "properties": {
                                                    "success": {
                                                        "type": "boolean"
                                                    },
                                                    "devices": {
                                                        "type": "array"
                                                    },
                                                    "total": {
                                                        "type": "integer"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "post": {
                            "summary": "Create new device",
                            "security": [
                                {
                                    "bearerAuth": []
                                }
                            ],
                            "requestBody": {
                                "required": true,
                                "content": {
                                    "application/json": {
                                        "schema": {
                                            "type": "object",
                                            "properties": {
                                                "serial_number": {
                                                    "type": "string"
                                                },
                                                "device_name": {
                                                    "type": "string"
                                                },
                                                "device_type": {
                                                    "type": "string",
                                                    "enum": [
                                                        "mobile",
                                                        "totem",
                                                        "notebook",
                                                        "desktop",
                                                        "printer",
                                                        "panel"
                                                    ]
                                                },
                                                "ip_address": {
                                                    "type": "string"
                                                },
                                                "mac_address": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "serial_number",
                                                "device_name",
                                                "device_type"
                                            ]
                                        }
                                    }
                                }
                            },
                            "responses": {
                                "201": {
                                    "description": "Device created successfully"
                                }
                            }
                        }
                    },
                    "/api/devices/{serialNumber}": {
                        "get": {
                            "summary": "Get device by serial number",
                            "security": [
                                {
                                    "bearerAuth": []
                                }
                            ],
                            "parameters": [
                                {
                                    "name": "serialNumber",
                                    "in": "path",
                                    "required": true,
                                    "schema": {
                                        "type": "string"
                                    }
                                }
                            ],
                            "responses": {
                                "200": {
                                    "description": "Device details"
                                },
                                "404": {
                                    "description": "Device not found"
                                }
                            }
                        },
                        "put": {
                            "summary": "Update device",
                            "security": [
                                {
                                    "bearerAuth": []
                                }
                            ],
                            "parameters": [
                                {
                                    "name": "serialNumber",
                                    "in": "path",
                                    "required": true,
                                    "schema": {
                                        "type": "string"
                                    }
                                }
                            ],
                            "requestBody": {
                                "required": true,
                                "content": {
                                    "application/json": {
                                        "schema": {
                                            "type": "object",
                                            "properties": {
                                                "device_name": {
                                                    "type": "string"
                                                },
                                                "status": {
                                                    "type": "string"
                                                },
                                                "ip_address": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                }
                            },
                            "responses": {
                                "200": {
                                    "description": "Device updated successfully"
                                }
                            }
                        },
                        "delete": {
                            "summary": "Delete device",
                            "security": [
                                {
                                    "bearerAuth": []
                                }
                            ],
                            "parameters": [
                                {
                                    "name": "serialNumber",
                                    "in": "path",
                                    "required": true,
                                    "schema": {
                                        "type": "string"
                                    }
                                }
                            ],
                            "responses": {
                                "200": {
                                    "description": "Device deleted successfully"
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "name": "Monitoring API",
            "description": "Receive monitoring data from devices (totems, mobile devices)",
            "files": [
                "routes/monitoringRoutes.js",
                "controllers/totemController.js",
                "models/Totem.js"
            ],
            "api_doc": {
                "openapi": "3.0.0",
                "paths": {
                    "/api/monitor": {
                        "post": {
                            "summary": "Receive monitoring data from devices",
                            "security": [
                                {
                                    "deviceAuth": []
                                }
                            ],
                            "requestBody": {
                                "required": true,
                                "content": {
                                    "application/json": {
                                        "schema": {
                                            "type": "object",
                                            "properties": {
                                                "serial_number": {
                                                    "type": "string"
                                                },
                                                "device_name": {
                                                    "type": "string"
                                                },
                                                "status": {
                                                    "type": "string"
                                                },
                                                "battery_level": {
                                                    "type": "number"
                                                },
                                                "cpu_usage": {
                                                    "type": "number"
                                                },
                                                "memory_usage": {
                                                    "type": "number"
                                                }
                                            }
                                        }
                                    }
                                }
                            },
                            "responses": {
                                "200": {
                                    "description": "Data received successfully"
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "name": "Module/Asset Management API",
            "description": "Manage modules and assets (applications, configurations) on devices",
            "files": [
                "routes/moduleRoutes.js",
                "routes/assetModuleRoutes.js",
                "controllers/assetModuleController.js",
                "models/AssetModule.js",
                "models/ManagedAsset.js"
            ],
            "api_doc": {
                "openapi": "3.0.0",
                "paths": {
                    "/api/modules": {
                        "get": {
                            "summary": "List all modules",
                            "security": [
                                {
                                    "bearerAuth": []
                                }
                            ],
                            "responses": {
                                "200": {
                                    "description": "List of modules"
                                }
                            }
                        },
                        "post": {
                            "summary": "Create new module",
                            "security": [
                                {
                                    "bearerAuth": []
                                }
                            ],
                            "requestBody": {
                                "required": true,
                                "content": {
                                    "application/json": {
                                        "schema": {
                                            "type": "object",
                                            "properties": {
                                                "name": {
                                                    "type": "string"
                                                },
                                                "version": {
                                                    "type": "string"
                                                },
                                                "package_name": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                }
                            },
                            "responses": {
                                "201": {
                                    "description": "Module created successfully"
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "name": "Command API",
            "description": "Send commands to devices (reboot, update apps, install, uninstall)",
            "files": [
                "routes/assetCommandRoutes.js",
                "controllers/assetCommandController.js",
                "models/AssetCommand.js"
            ],
            "api_doc": {
                "openapi": "3.0.0",
                "paths": {
                    "/api/assets/{assetId}/commands": {
                        "post": {
                            "summary": "Send command to device",
                            "security": [
                                {
                                    "bearerAuth": []
                                }
                            ],
                            "parameters": [
                                {
                                    "name": "assetId",
                                    "in": "path",
                                    "required": true,
                                    "schema": {
                                        "type": "string"
                                    }
                                }
                            ],
                            "requestBody": {
                                "required": true,
                                "content": {
                                    "application/json": {
                                        "schema": {
                                            "type": "object",
                                            "properties": {
                                                "command_type": {
                                                    "type": "string",
                                                    "enum": [
                                                        "reboot",
                                                        "update_apps",
                                                        "install",
                                                        "uninstall"
                                                    ]
                                                },
                                                "parameters": {
                                                    "type": "object"
                                                }
                                            }
                                        }
                                    }
                                }
                            },
                            "responses": {
                                "200": {
                                    "description": "Command sent successfully"
                                }
                            }
                        }
                    }
                }
            }
        },
