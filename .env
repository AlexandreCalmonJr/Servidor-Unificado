# ===================================================================
# ARQUIVO DE CONFIGURAÇÃO DO SERVIDOR MDM
# ===================================================================

# ===================================================================
# BANCO DE DADOS
# ===================================================================
# Para desenvolvimento local (sem Docker):
# MONGO_URI=mongodb://localhost:27017/mdm

# Para Docker (use o nome do serviço do docker-compose):
MONGO_URI=mongodb://localhost:27017/mdm

# ===================================================================
# SEGURANÇA
# ===================================================================
# Chave secreta para JWT (mínimo 32 caracteres)
# Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=sua_chave_super_secreta_com_pelo_menos_32_caracteres_aqui
TEST_TOKEN=hap@2025
# Token para autenticação de dispositivos (agentes)
AUTH_TOKEN=hap@2025

# ===================================================================
# SERVIDOR
# ===================================================================
PORT=3000
NODE_ENV=development

# ===================================================================
# LOGS
# ===================================================================
# Níveis: error, warn, info, http, debug
LOG_LEVEL=info

# ===================================================================
# CACHE E PERFORMANCE
# ===================================================================
# Redis para cache e rate limiting
# ⚙️ true = Usa Redis (requer Redis rodando)
# ⚙️ false = Usa cache em memória (padrão, sem Redis)
REDIS_ENABLED=false

# Para desenvolvimento local (sem Docker):
# REDIS_URL=redis://127.0.0.1:6379

# Para Docker (use o nome do serviço do docker-compose):
REDIS_URL=redis://redis:6379

# ===================================================================
# NOTAS IMPORTANTES
# ===================================================================
# 1. JWT_SECRET: Use uma string longa e aleatória em produção
#
# 2. AUTH_TOKEN: Token usado pelos agentes para autenticação
#    Deve ser o mesmo no servidor e nos dispositivos
#
# 3. REDIS_ENABLED: 
#    - true = Usa Redis (melhor performance, recomendado)
#    - false = Cache em memória (funciona mas perde dados ao reiniciar)
#
# 4. REDIS_URL:
#    - Docker: Use redis://redis:6379 (nome do serviço)
#    - Local: Use redis://127.0.0.1:6379 ou redis://localhost:6379
#
# 5. MONGO_URI:
#    - Docker: Use mongodb://mongodb:27017/mdm (nome do serviço)
#    - Local: Use mongodb://localhost:27017/mdm
#
# 6. NODE_ENV:
#    - development = Logs detalhados no console
#    - production = Logs apenas em arquivos
