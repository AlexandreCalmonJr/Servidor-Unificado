{
    "name": "unified-desktop-agent",
    "version": "1.0.0",
    "description": "Visual Agent for Unified Server (Windows/Linux)",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "dist": "electron-builder"
    },
    "build": {
        "appId": "com.unified.agent",
        "productName": "Unified Agent",
        "win": {
            "target": [
                "nsis",
                "portable"
            ],
            "icon": "assets/icon.png"
        },
        "directories": {
            "output": "dist"
        }
    },
    "dependencies": {
        "axios": "^1.13.5",
        "electron-store": "^8.1.0",
        "node-cron": "^3.0.0",
        "systeminformation": "^5.31.1",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1"
    }
}
